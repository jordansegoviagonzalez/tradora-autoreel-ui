// --- Initialization ---
function init() {
  setupEventListeners();
  loadSessions();
  loadSettings();
  loadProfile();
  updateSubmitState();
  checkEngineConnection();
}

function setupEventListeners() {
  // Navigation and settings
  DOM.brandHome.addEventListener('click', showCreateView);
  DOM.backToCreateBtn.addEventListener('click', showCreateView);
  DOM.profileMenuTrigger.addEventListener('click', toggleProfileMenu);
  DOM.menuProfile.addEventListener('click', () => {
    closeProfileMenu();
    showProfileView();
  });
  DOM.menuSettings.addEventListener('click', () => {
    closeProfileMenu();
    DOM.settingsModal.classList.remove('hidden');
  });
  DOM.menuEngineMonitor.addEventListener('click', () => {
    closeProfileMenu();
    showEngineMonitor();
  });
  document.addEventListener('click', (e) => {
    if (!DOM.profileMenu.contains(e.target) && !DOM.profileMenuTrigger.contains(e.target)) {
      closeProfileMenu();
    }
  });
  DOM.closeModal.addEventListener('click', () => DOM.settingsModal.classList.add('hidden'));
  if (DOM.gotoProfileBtn) {
    DOM.gotoProfileBtn.addEventListener('click', () => {
      DOM.settingsModal.classList.add('hidden');
      showProfileView();
    });
  }
  DOM.saveProfileBtn.addEventListener('click', saveProfile);
  DOM.testConnectionBtn.addEventListener('click', testConnectionModal);
  DOM.instructionsInput.addEventListener('input', () => {
    updateSubmitState();
    updateMonitorSummary();
    autoResizeTextarea();
  });
  if (DOM.instructionsInput) {
    DOM.instructionsInput.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      if (event.shiftKey) {
        return;
      }
      event.preventDefault();
      console.log("[AutoReel] Enter pressed in Axia composer");
      handleSendToAxia();
    });
  }
  DOM.generateAnotherBtn.addEventListener('click', resetCreateFlow);
  DOM.sidebarToggle.addEventListener('click', toggleSessionsSidebar);
  DOM.newSessionBtn.addEventListener('click', resetCreateFlow);

  // Drag and Drop
  DOM.dropZone.addEventListener('click', () => DOM.fileInput.click());
  DOM.dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    DOM.dropZone.classList.add('dragover');
  });
  DOM.dropZone.addEventListener('dragleave', () => DOM.dropZone.classList.remove('dragover'));
  DOM.dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    DOM.dropZone.classList.remove('dragover');
    if (e.dataTransfer.files.length) handleFiles(e.dataTransfer.files);
  });
  DOM.fileInput.addEventListener('change', (e) => {
    if (e.target.files.length) handleFiles(e.target.files);
  });

  window.addEventListener('apiRequestEvent', (e) => {
    if (DOM.monitorRequestType) DOM.monitorRequestType.textContent = e.detail.type;
    if (DOM.monitorRequestUrl) DOM.monitorRequestUrl.textContent = e.detail.url;
    if (DOM.monitorResponseStatus) DOM.monitorResponseStatus.textContent = e.detail.status;
    if (DOM.monitorErrorSummary) DOM.monitorErrorSummary.textContent = e.detail.error;
  });

  // Submit
  DOM.reviewBtn.addEventListener('click', handleSendToAxia);
  DOM.submitBtn.addEventListener('click', submitJob);
}